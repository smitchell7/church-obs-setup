# Copy to secrets.env (git-ignored) and fill in. Then run ./render-autoinstall.py
HOSTNAME_PREFIX=church
# Plain-text passwords; render-autoinstall.py hashes them (SHA-512) into user-data.
# broadcast is the auto-login user and the only one with sudo.
PASSWORD_BROADCAST=
PASSWORD_LIAHONA=
PASSWORD_LEHI=
WIFI1_SSID=
WIFI1_PSK=
WIFI2_SSID=
WIFI2_PSK=
WALLPAPER_URL=
# Which folder in configs/ to install on first boot: single-camera or dual-camera
OBS_CONFIG=single-camera
