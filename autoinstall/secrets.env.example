# Copy to secrets.env (git-ignored) and fill in. Then run ./render-autoinstall.py
HOSTNAME_PREFIX=church
# Plain-text password; render-autoinstall.py hashes it (SHA-512) into user-data.
# broadcast is the auto-login user, the only account, and has sudo.
PASSWORD_BROADCAST=
# The two Wi-Fi networks (name and password); the computer joins whichever it can see
WIFI1_SSID=
WIFI1_PSK=
WIFI2_SSID=
WIFI2_PSK=
WALLPAPER_URL=
# Password for OBS's WebSocket server (port 4455), used by remote controls. Letters, digits and hyphens only.
OBS_WEBSOCKET_PASSWORD=
# Where the new computer clones this repo from on first boot (it must be reachable from the church network)
REPO_URL=
# Which folder in configs/ to install on first boot: single-camera or dual-camera
OBS_CONFIG=single-camera
